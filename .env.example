# Copy to .env for local dev, and set the same values in Vercel
# (Project -> Settings -> Environment Variables) for production.
#
# When these are present, the app stores the board in your GitHub repo, so the
# web app and any AI agent with repo access share one source of truth.
# When absent, local dev falls back to writing ./board.json on disk.

# Fine-grained Personal Access Token with "Contents: Read and write" on this repo only.
GITHUB_TOKEN=github_pat_xxxxxxxx

GITHUB_OWNER=tkarol
GITHUB_REPO=ai-jira-board

# Branch that holds the live board data. Recommended: a dedicated "board-data"
# branch so data commits don't clutter your code history. If you leave this
# unset in production, it defaults to the branch Vercel deployed from.
GITHUB_DATA_BRANCH=board-data

# Optional: paths to the data files in the repo (default to board.json / planner.json).
# GITHUB_BOARD_PATH=board.json
# GITHUB_PLANNER_PATH=planner.json

# --- Social media planner: photo storage -----------------------------------
# Vercel Blob stores uploaded photos (the repo only keeps their URLs). On Vercel,
# create a Blob store (Storage tab) and this variable is injected automatically.
# Without it, local dev saves photos to ./uploads instead.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# --- Social media planner: publishing engine (wired up later) --------------
# Social account tokens / API keys will go here as server-side env vars.
# NEVER commit these or put them in board.json / planner.json.
# e.g. AYRSHARE_API_KEY=...   TWITTER_BEARER_TOKEN=...   META_ACCESS_TOKEN=...
